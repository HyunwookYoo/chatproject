<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <application>
        <!-- Debug only: fake pushes for tests without Firebase (TestPushReceiver.kt). Exported
             without a permission so adb can send them. -->
        <receiver
            android:name=".TestPushReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="dev.chatproject.chat_app.TEST_PUSH"/>
            </intent-filter>
        </receiver>
    </application>
</manifest>
